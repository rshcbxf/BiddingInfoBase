# ==========================================
# 测试文档忽略规则
# ==========================================

# 测试目录中的所有办公文档
sample_doc/

# 临时测试文件
*~test*.pdf
*~test*.doc
*~test*.docx
temp*.pdf
temp*.doc
temp*.docx

# 只忽略根目录下的一次性脚本，保留 tools/archive/ 中的归档脚本
/test*.py
/temp*.py

# ==========================================
# 标准 Python 项目忽略（示例）
# ==========================================

# 字节码
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
.env/
.venv/

# IDE
.idea/
.vscode/
*.swp

# 构建产物
build/
dist/
*.egg-info/

# 但保留项目文档目录
!docs/**/*.pdf
!docs/**/*.doc